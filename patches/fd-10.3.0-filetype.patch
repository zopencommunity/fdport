+// z/OS uses non-POSIX st_mode constants (S_IFREG=0x03000000, S_IFDIR=0x01000000,
+// S_IFLNK=0x05000000, S_IFBLK=0x06000000, S_IFMT=0xFF000000). Rust std is compiled
+// with POSIX masks (0x8000, 0x4000) so FileType::is_file()/is_dir()/is_symlink()
+// always return false. Use st_mode directly via MetadataExt on z/OS.
+#[cfg(target_os = "zos")]
+mod zos_filetype {
+    use std::fs;
+    use std::os::unix::fs::MetadataExt;
+
+    const S_IFMT:   u32 = 0xFF00_0000;
+    const S_IFREG:  u32 = 0x0300_0000;
+    const S_IFDIR:  u32 = 0x0100_0000;
+    const S_IFLNK:  u32 = 0x0500_0000; // from libc-zos; 0x06=S_IFBLK on z/OS
+    const S_IFBLK:  u32 = 0x0600_0000;
+    const S_IFCHR:  u32 = 0x0200_0000;
+    const S_IFSOCK: u32 = 0x0700_0000;
+    const S_IFIFO:  u32 = 0x0400_0000;
+
+    fn mode_type(md: Option<&fs::Metadata>) -> Option<u32> {
+        md.map(|m| m.mode() & S_IFMT)
+    }
+
+    pub fn is_file(ft: &fs::FileType, md: Option<&fs::Metadata>) -> bool {
+        mode_type(md).map_or_else(|| ft.is_file(), |t| t == S_IFREG)
+    }
+
+    pub fn is_dir(ft: &fs::FileType, md: Option<&fs::Metadata>) -> bool {
+        mode_type(md).map_or_else(|| ft.is_dir(), |t| t == S_IFDIR)
+    }
+
+    pub fn is_symlink(ft: &fs::FileType, md: Option<&fs::Metadata>) -> bool {
+        mode_type(md).map_or_else(|| ft.is_symlink(), |t| t == S_IFLNK)
+    }
+
+    pub fn is_block_device(_ft: &fs::FileType, md: Option<&fs::Metadata>) -> bool {
+        mode_type(md).map_or(false, |t| t == S_IFBLK)
+    }
+
+    pub fn is_char_device(_ft: &fs::FileType, md: Option<&fs::Metadata>) -> bool {
+        mode_type(md).map_or(false, |t| t == S_IFCHR)
+    }
+
+    pub fn is_socket(_ft: &fs::FileType, md: Option<&fs::Metadata>) -> bool {
+        mode_type(md).map_or(false, |t| t == S_IFSOCK)
+    }
+
+    pub fn is_pipe(_ft: &fs::FileType, md: Option<&fs::Metadata>) -> bool {
+        mode_type(md).map_or(false, |t| t == S_IFIFO)
+    }
+}
