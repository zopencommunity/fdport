+pub use zos_filetype::{is_file as ft_is_file, is_dir as ft_is_dir, is_symlink as ft_is_symlink};
+
+// z/OS-aware Path::is_file() — uses stat + S_IFREG check directly.
+pub fn path_is_file(path: &Path) -> bool {
+    #[cfg(target_os = "zos")]
+    {
+        use std::os::unix::fs::MetadataExt;
+        const S_IFMT:  u32 = 0xFF00_0000;
+        const S_IFREG: u32 = 0x0300_0000;
+        match fs::metadata(path) {
+            Ok(m) => (m.mode() & S_IFMT) == S_IFREG,
+            Err(_) => false,
+        }
+    }
+    #[cfg(not(target_os = "zos"))]
+    path.is_file()
+}
+
+// z/OS-aware Path::is_dir() — uses stat + S_IFDIR check directly.
+pub fn path_is_dir(path: &Path) -> bool {
+    #[cfg(target_os = "zos")]
+    {
+        use std::os::unix::fs::MetadataExt;
+        const S_IFMT:  u32 = 0xFF00_0000;
+        const S_IFDIR: u32 = 0x0100_0000;
+        match fs::metadata(path) {
+            Ok(m) => (m.mode() & S_IFMT) == S_IFDIR,
+            Err(_) => false,
+        }
+    }
+    #[cfg(not(target_os = "zos"))]
+    path.is_dir()
+}
