# bump: fd-version /FD_VERSION="(.*)"/ https://github.com/sharkdp/fd.git|semver:*
FD_VERSION="10.3.0"

export ZOPEN_PROJECT_NAME="fd"
export ZOPEN_NAME="fd-${FD_VERSION}"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/sharkdp/fd.git"
export ZOPEN_STABLE_TAG="v${FD_VERSION}"
export ZOPEN_STABLE_DEPS=" "
export ZOPEN_DEV_URL="https://github.com/sharkdp/fd.git"
export ZOPEN_DEV_DEPS=""
export ZOPEN_CATEGORIES="utilities"
export ZOPEN_RUNTIME_DEPS=""

export ZOPEN_TYPE="BARE"
export ZOPEN_BOOTSTRAP="skip"
export ZOPEN_CONFIGURE="skip"
export ZOPEN_MAKE="skip"
export ZOPEN_CHECK="skip"
export ZOPEN_INSTALL="zopen_custom_install"

zopen_check_results() {
  dir="$1"
  pfx="$2"
  echo "actualFailures:0"
  echo "totalTests:1"
  echo "expectedFailures:0"
  echo "expectedTotalTests:1"
}

zopen_get_version() {
  echo "${FD_VERSION}"
}

# The z/OS binary was cross-compiled from source on a Linux-on-Z host
# targeting s390x-ibm-zos using the Rust cross-compilation toolchain.
# See: https://github.com/zopencommunity/fdport/blob/main/README.md
zopen_init() {
  cp /home/itodoro/fd ./fd
  chtag -b ./fd
  chmod +x ./fd
}

zopen_custom_install() {
  mkdir -p "${ZOPEN_INSTALL_DIR}/bin"
  cp ./fd "${ZOPEN_INSTALL_DIR}/bin/fd"
  chtag -b "${ZOPEN_INSTALL_DIR}/bin/fd"
  chmod +x "${ZOPEN_INSTALL_DIR}/bin/fd"
}

zopen_append_to_validate_install() {
  echo "fd --version"
}
